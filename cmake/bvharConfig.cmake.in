@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3 3.4)
find_dependency(lbfgspp 0.4.0)
find_dependency(spdlog 1.15.3)
find_dependency(Boost 1.87.0 COMPONENTS random math accumulators optional)

if(@OpenMP_CXX_FOUND@)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/bvharTargets.cmake")